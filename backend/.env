CLIENT_ORIGIN=http://localhost:5173

AUTH_SERVICE_PORT=3000
EMPLOYEE_SERVICE_PORT=3001
PATIENT_SERVICE_PORT=3002

AUTH_DB_PORT=5433
EMPLOYEE_DB_PORT=5434
PATIENT_DB_PORT=5435

AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=postgres
AUTH_DB_NAME=clinic_auth

EMPLOYEE_DB_USER=postgres
EMPLOYEE_DB_PASSWORD=postgres
EMPLOYEE_DB_NAME=clinic_employee

PATIENT_DB_USER=postgres
PATIENT_DB_PASSWORD=postgres
PATIENT_DB_NAME=clinic_patient

JWT_ISSUER=clinic-auth-service
JWT_AUDIENCE=clinic-resource-services
JWT_EXPIRES_IN=15m
INTERNAL_SERVICE_TOKEN=change-this-in-real-environments

